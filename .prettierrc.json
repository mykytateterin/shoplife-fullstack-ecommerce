{
  "$schema": "https://www.schemastore.org/prettierrc.json",
  "arrowParens": "always",
  "bracketSpacing": true,
  "endOfLine": "auto",
  "jsxSingleQuote": false,
  "overrides": [
    {
      "files": "**/*.json",
      "options": {
        "parser": "jsonc",
        "trailingComma": "none"
      }
    }
  ],
  "printWidth": 100,
  "semi": true,
  "singleQuote": true,
  "tabWidth": 2,
  "trailingComma": "all"
}
