{
  "$schema": "https://www.schemastore.org/package.json",
  "devDependencies": {
    "@shoplife/eslint-config": "workspace:*",
    "@shoplife/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "husky": "catalog:",
    "lint-staged": "catalog:",
    "prettier": "catalog:",
    "stylelint": "catalog:",
    "stylelint-config-standard-scss": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:"
  },
  "lint-staged": {
    "*.{css,scss,sass}": [
      "prettier --write",
      "stylelint --fix"
    ],
    "*.{yaml,yml,json,jsonc,json5,js,mjs,cjs,ts,tsx,mts,cts}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.prisma": [
      "pnpm --filter @shoplife/server exec prisma format --schema",
      "pnpm --filter @shoplife/server exec prisma validate --schema"
    ]
  },
  "name": "shoplife-monorepo",
  "private": true,
  "scripts": {
    "dev:client": "pnpm --filter @shoplife/client dev",
    "dev:server": "pnpm --filter @shoplife/server dev",
    "format:all": "prettier --write .",
    "lint": "eslint *",
    "lint:all": "pnpm -r lint",
    "lint:fix": "eslint * --fix",
    "lint:fix:all": "pnpm -r lint:fix",
    "prepare": "husky",
    "test:server": "pnpm --filter @shoplife/server test",
    "typecheck": "tsc --noEmit",
    "typecheck:all": "pnpm -r typecheck"
  },
  "type": "module"
}
