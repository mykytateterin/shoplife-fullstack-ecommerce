{
  "$schema": "https://www.schemastore.org/package.json",
  "dependencies": {
    "@react-router/node": "catalog:client",
    "@react-router/serve": "catalog:client",
    "@shoplife/contracts": "workspace:*",
    "isbot": "catalog:client",
    "motion": "catalog:client",
    "normalize.css": "catalog:client",
    "react": "catalog:client",
    "react-dom": "catalog:client",
    "react-router": "catalog:client",
    "zod": "catalog:",
    "zustand": "catalog:client"
  },
  "devDependencies": {
    "@react-router/dev": "catalog:client",
    "@react-router/fs-routes": "catalog:client",
    "@shoplife/eslint-config": "workspace:*",
    "@shoplife/tsconfig": "workspace:*",
    "@types/react": "catalog:client",
    "@types/react-dom": "catalog:client",
    "sass-embedded": "catalog:client"
  },
  "name": "@shoplife/client",
  "private": true,
  "scripts": {
    "build": "react-router build",
    "dev": "react-router dev",
    "lint": "eslint . && stylelint **/*.{css,scss,sass}",
    "lint:fix": "eslint . --fix && stylelint **/*.{css,scss,sass} --fix",
    "start": "react-router-serve ./build/server/index.js",
    "typecheck": "react-router typegen && tsc --noEmit"
  },
  "type": "module"
}
